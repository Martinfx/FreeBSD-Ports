Build Niik-l/Natron RB-2.6 on FreeBSD with Qt6/PySide6, without Cycles
and wgpu (NATRON_CYCLES=OFF, NATRON_FASTVOLUME=OFF).

- CMake: do not inherit Py_LIMITED_API from an abi3 shiboken6: Natron
  embeds Python and uses the full C API (PyRun_String,
  PyTuple_SET_ITEM, ...).
- Engine: find Imath through its CMake config instead of the MSYS2
  path, and always build KnobPassTable, which KnobFactory and
  KnobSerialization use even without Cycles.
- Gui: link OpenColorIO (>= 2.3), used by ViewerGLPrivate.cpp.
- Without Cycles, CyclesRenderPass::refreshSettingsInfo() and
  KnobGuiPassTable::onRefreshObjects() must not reference the Cycles
  classes.
- Signals removed in Qt6 (connect() failed at runtime):
  QComboBox::activated(QString) -> textActivated(QString),
  QProcess::error(...) -> errorOccurred(...).

diff --git CMakeLists.txt CMakeLists.txt
index 48a0049bd..b99562b02 100644
--- CMakeLists.txt
+++ CMakeLists.txt
@@ -97,6 +97,13 @@ if(NATRON_QT6)
     set(SHIBOKEN_EXE Shiboken6::shiboken6)
     set(SHIBOKEN_LIB Shiboken6::libshiboken)
     set(PYSIDE_LIB PySide6::pyside6)
+
+    # Natron embeds Python and uses the full C API (PyRun_String,
+    # PyTuple_SET_ITEM, ...), so do not inherit Py_LIMITED_API from an
+    # abi3 build of shiboken6.
+    get_property(SHIBOKEN_DEFS TARGET Shiboken6::libshiboken PROPERTY INTERFACE_COMPILE_DEFINITIONS)
+    list(FILTER SHIBOKEN_DEFS EXCLUDE REGEX "^Py_LIMITED_API")
+    set_property(TARGET Shiboken6::libshiboken PROPERTY INTERFACE_COMPILE_DEFINITIONS ${SHIBOKEN_DEFS})
 else()
     find_package(Qt5 5.15 CONFIG REQUIRED COMPONENTS ${QT_COMPONENTS})
     find_package(Shiboken2 5.15 CONFIG REQUIRED COMPONENTS libshiboken2 shiboken2)
