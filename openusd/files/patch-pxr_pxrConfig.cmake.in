--- pxr/pxrConfig.cmake.in.orig	2026-04-24 18:55:54 UTC
+++ pxr/pxrConfig.cmake.in
@@ -9,7 +9,9 @@
 # PXR_foo_LIBRARY   - Absolute path to individual libraries.
 # The preprocessor definition PXR_STATIC will be defined if appropriate
 
-get_filename_component(PXR_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
+# pxrConfig.cmake is installed into lib/cmake/pxr, PXR_CMAKE_DIR is the
+# installation prefix.
+get_filename_component(PXR_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
 
 set(PXR_MAJOR_VERSION "@PXR_MAJOR_VERSION@")
 set(PXR_MINOR_VERSION "@PXR_MINOR_VERSION@")
@@ -90,6 +92,19 @@ if(@PXR_ENABLE_MATERIALX_SUPPORT@)
     find_dependency(MaterialX)
 endif()
 
+# The exported imaging targets link against OpenGL::GL, so make sure that
+# target is defined for consumers.
+# See https://github.com/PixarAnimationStudios/OpenUSD/issues/3310
+if(@PXR_BUILD_IMAGING@ AND @PXR_ENABLE_GL_SUPPORT@)
+    find_dependency(OpenGL)
+endif()
+
+# Likewise for Ptex, as hdSt links against Ptex::Ptex_dynamic from the CMake
+# package of Ptex.
+if(@PXR_BUILD_IMAGING@ AND @PXR_ENABLE_PTEX_SUPPORT@)
+    find_dependency(PTex CONFIG)
+endif()
+
 # Similar to MaterialX above, we are using Imath's cmake package config, so set
 # the Imath_DIR accordingly to find the associated import targets which were
 # used for this USD build. 
@@ -115,7 +130,7 @@ if(NOT "@PXR_WORK_IMPL_PACKAGE@" STREQUA
     find_dependency(@PXR_WORK_IMPL_PACKAGE@)
 endif()
 
-include("${PXR_CMAKE_DIR}/cmake/pxrTargets.cmake")
+include("${CMAKE_CURRENT_LIST_DIR}/pxrTargets.cmake")
 if (TARGET usd_m)
     set(libs "usd_m")
 else()
