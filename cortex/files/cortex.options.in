# SCons options used to build Cortex. These are given in an options file
# rather than on the command line because the SConstruct expects the flags
# variables to be lists.

CXX = "%%CXX%%"
CXXFLAGS = "%%CXXFLAGS%%".split()
# Upstream builds its libraries without a SONAME, which pkg(8) needs in
# order to register them as provided by this package.
LINKFLAGS = "%%LDFLAGS%%".split() + [ "-Wl,-soname,${TARGET.file}" ]
CXXSTD = "c++17"
BUILD_TYPE = "RELEASE"
WARNINGS_AS_ERRORS = False
ENV_VARS_TO_IMPORT = "PATH TERM"

PYTHON = "%%PYTHON_CMD%%"
PYTHON_CONFIG = "%%PYTHON_CMD%%-config"
PYTHON_INCLUDE_PATH = "%%PYTHON_INCLUDEDIR%%"

LIBPATH = "%%LOCALBASE%%/lib"
BOOST_INCLUDE_PATH = "%%LOCALBASE%%/include"
BOOST_LIB_PATH = "%%LOCALBASE%%/lib"
BOOST_LIB_SUFFIX = ""
OPENEXR_INCLUDE_PATH = "%%LOCALBASE%%/include"
ILMBASE_INCLUDE_PATH = "%%LOCALBASE%%/include"
OPENEXR_LIB_PATH = "%%LOCALBASE%%/lib"
TBB_INCLUDE_PATH = "%%LOCALBASE%%/include"
BLOSC_INCLUDE_PATH = "%%LOCALBASE%%/include"
FREETYPE_INCLUDE_PATH = "%%LOCALBASE%%/include/freetype2"
OIIO_INCLUDE_PATH = "%%LOCALBASE%%/include"
VDB_INCLUDE_PATH = "%%LOCALBASE%%/include"
NANOBIND_INCLUDE_PATH = "%%LOCALBASE%%/include"
NANOBIND_LIB_PATH = "%%WRKDIR%%/nanobind"
WITH_GL = True
GLEW_INCLUDE_PATH = "%%LOCALBASE%%/include"
USD_INCLUDE_PATH = "%%LOCALBASE%%/include"
USD_LIB_PATH = "%%LOCALBASE%%/lib"
USD_LIB_PREFIX = ""
WITH_USD_MONOLITHIC = True
ALEMBIC_INCLUDE_PATH = "%%LOCALBASE%%/include"
# The SConstruct emits `-isystem $<NAME>_INCLUDE_PATH` pairs even for unused
# dependencies, so none of these may be left empty.
HDF5_INCLUDE_PATH = "%%LOCALBASE%%/include"
PYBIND11_INCLUDE_PATH = "%%LOCALBASE%%/include"
DOXYGEN = "/nonexistent"

INSTALL_PREFIX = "%%STAGEDIR%%%%PREFIX%%"
INSTALL_PYTHON_DIR = "%%STAGEDIR%%%%PYTHON_SITELIBDIR%%"
# USD discovers plugins in `lib/usd/*/resources` automatically.
INSTALL_USD_RESOURCE_DIR = "%%STAGEDIR%%%%PREFIX%%/lib/usd"
INSTALL_GLSL_HEADER_DIR = "%%STAGEDIR%%%%DATADIR%%/glsl"
INSTALL_GLSL_SHADER_DIR = "%%STAGEDIR%%%%DATADIR%%/glsl"
INSTALL_IECORE_OPS = []
