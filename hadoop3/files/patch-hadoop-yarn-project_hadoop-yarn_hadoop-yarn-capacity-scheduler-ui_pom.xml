+    <!-- FreeBSD: nodejs.org publishes no FreeBSD binaries for
+         frontend-maven-plugin to download.  Use the node and npm from the
+         ports tree instead; the port links them into ${webappDir}/node, which
+         is where the npm goal and ${nodeExecutable} look for them. -->
+    <profile>
+      <id>yarn-ui-system-node</id>
+      <activation>
+        <os>
+          <family>FreeBSD</family>
+        </os>
+      </activation>
+      <build>
+        <plugins>
+          <plugin>
+            <groupId>com.github.eirslett</groupId>
+            <artifactId>frontend-maven-plugin</artifactId>
+            <version>${frontend-maven-plugin.version}</version>
+            <executions>
+              <execution>
+                <id>install node and npm</id>
+                <phase>none</phase>
+              </execution>
+            </executions>
+          </plugin>
+        </plugins>
+      </build>
+    </profile>
+
