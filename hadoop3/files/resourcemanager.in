#!/bin/sh
#
# PROVIDE: resourcemanager
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# resourcemanager_enable (bool):		Set to NO by default.
#				Set it to YES to enable resourcemanager.
# resourcemanager_user (str):		User to run resourcemanager as.
#				Default: mapred
# resourcemanager_conf_dir (str):	Hadoop configuration directory.
#				Default: %%ETCDIR%%
# resourcemanager_ident (str):		HADOOP_IDENT_STRING, i.e. the `hadoop-<ident>-resourcemanager'
#				part of the log and pid file names.
#				Default: yarn

. /etc/rc.subr

name=resourcemanager
rcvar=resourcemanager_enable

load_rc_config "${name}"

: ${resourcemanager_enable:="NO"}
: ${resourcemanager_user:="mapred"}
: ${resourcemanager_conf_dir:="%%ETCDIR%%"}
: ${resourcemanager_ident:="yarn"}

# `yarn --daemon' forks, writes its own pid file and execs java, so rc.subr
# cannot track it through ${command} -- drive it through the helpers below.
hadoop_command="%%PREFIX%%/bin/yarn"
hadoop_subcmd="resourcemanager"
procname="%%JAVA_HOME%%/bin/java"
pidfile="%%HADOOP_RUNDIR%%/hadoop-${resourcemanager_ident}-${hadoop_subcmd}.pid"

start_cmd="resourcemanager_start"
stop_cmd="resourcemanager_stop"
status_cmd="resourcemanager_status"

hadoop_doit()
{
	# Same quoting dance rc.subr itself uses for ${name}_user, so that the
	# target account's login shell is not required to understand -c.
	su -m "${resourcemanager_user}" -c "sh -c '\
	    PATH=\"\${PATH}:%%LOCALBASE%%/bin\" \
	    HADOOP_IDENT_STRING=\"${resourcemanager_ident}\" \
	    ${hadoop_command} --config \"${resourcemanager_conf_dir}\" \
	    --daemon $1 ${hadoop_subcmd}'"
}

resourcemanager_start()
{
	rc_pid=$(check_pidfile "${pidfile}" "${procname}")
	if [ -n "${rc_pid}" ]; then
		echo "${name} already running? (pid=${rc_pid})."
		return 1
	fi
	echo "Starting ${name}."
	hadoop_doit start || return 1
}

resourcemanager_stop()
{
	rc_pid=$(check_pidfile "${pidfile}" "${procname}")
	if [ -z "${rc_pid}" ]; then
		echo "${name} not running? (check ${pidfile})."
		return 1
	fi
	echo "Stopping ${name}."
	hadoop_doit stop
}

resourcemanager_status()
{
	rc_pid=$(check_pidfile "${pidfile}" "${procname}")
	if [ -n "${rc_pid}" ]; then
		echo "${name} is running as pid ${rc_pid}."
	else
		echo "${name} is not running."
		return 1
	fi
}

run_rc_command "$1"
