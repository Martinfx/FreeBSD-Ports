--- board/mediatek/mt7622/bananapi_bpi-r64.env.orig	1970-01-01 00:00:00 UTC
+++ board/mediatek/mt7622/bananapi_bpi-r64.env
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Environment for the Banana Pi BPI-R64 (MT7622).
+ *
+ * DRAM is 0x40000000 - 0x7fffffff; TF-A BL31 lives at 0x43000000.
+ */
+
+scriptaddr=0x40100000
+pxefile_addr_r=0x40200000
+fdt_addr_r=0x40300000
+kernel_addr_r=0x44000000
+ramdisk_addr_r=0x48000000
+fdtfile=mediatek/mt7622-bananapi-bpi-r64.dtb
+console=ttyS0,115200
